# Copy to .env and adjust as needed. .env is git-ignored; never commit real keys.

# Data providers. Neither current provider requires a key.
FX_API_BASE_URL=https://api.frankfurter.dev/v2
CPI_API_BASE_URL=https://api.imf.org/external/sdmx/2.1

# Reserved for keyed providers. Read only on the server; never sent to the browser.
EXCHANGE_RATE_API_KEY=
INFLATION_API_KEY=

# Cache location and lifetimes (seconds)
# CACHE_DIR=.cache/quantile
# FX_CURRENT_TTL=3600
# FX_RECENT_TTL=604800
# FX_HISTORY_TTL=7776000
# CPI_TTL=604800
# ANALYSIS_TTL=600

# Download history in the background when the server starts
# PREWARM_ON_STARTUP=true
